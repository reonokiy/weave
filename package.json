{
  "name": "weave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:e2e": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.44.0",
    "dompurify": "^3.4.15",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "unocss": "^66.10.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
